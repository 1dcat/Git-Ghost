# Provider used by `git ghost ask`: openai | anthropic
GHOST_LLM_PROVIDER=openai

# Required when GHOST_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Required when GHOST_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Scope B writes refs only beneath this prefix.
GHOST_REF_NAMESPACE=refs/ghost

# Lines of surrounding source included with a blame chunk.
GHOST_BLAME_CONTEXT_LINES=12

# Cap on the author diff injected into the persona prompt.
GHOST_MAX_DIFF_BYTES=24000

# Dashboard binds to loopback only.
GHOST_GUI_HOST=127.0.0.1
GHOST_GUI_PORT=4737
