# openai | anthropic | local
# local needs no API key. It talks to Ollama, or any OpenAI-compatible server.
GHOST_LLM_PROVIDER=local

# Required when GHOST_LLM_PROVIDER=local. Use a name from `ollama list`.
GHOST_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
GHOST_LOCAL_MODEL=qwen2.5-coder:7b

# Required only when GHOST_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Required only when GHOST_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Scope B writes refs only beneath this prefix.
GHOST_REF_NAMESPACE=refs/ghost

# Lines of surrounding source included with a blame chunk.
GHOST_BLAME_CONTEXT_LINES=12

# Cap on the author diff injected into the persona prompt.
GHOST_MAX_DIFF_BYTES=24000

# Dashboard binds to loopback only.
GHOST_GUI_HOST=127.0.0.1
GHOST_GUI_PORT=4737
